generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Member {
  id             String             @id @default(cuid())
  name           String
  phone          String
  password       String
  memberCode     String             @unique
  panNumber      String
  kycStatus      String             @default("PENDING")
  photoUrl       String?
  address        String?
  city           String?
  state          String?
  dateOfBirth    DateTime?
  issuedPassword String?
  sponsorId      String?
  sponsor        Member?            @relation("Sponsor", fields: [sponsorId], references: [id])
  referrals      Member[]           @relation("Sponsor")
  parentId       String?
  parent         Member?            @relation("BinaryTree", fields: [parentId], references: [id])
  children       Member[]           @relation("BinaryTree")
  position       String?
  role           String             @default("MEMBER")
  rank           String?
  status         String             @default("PENDING_PAYMENT")
  activatedAt    DateTime?
  accountName    String?
  bankName       String?
  accountNumber  String?
  ifsc           String?
  upiId          String?
  wallet         Wallet?
  volumes        BinaryVolume[]
  orders         Order[]
  payments       PaymentSubmission[]
  kycSubmissions KycSubmission[]
  pinsOwned      Pin[]              @relation("PinOwner")
  weeklyPayouts  WeeklyPayout[]
  createdAt      DateTime           @default(now())

  @@index([phone])
  @@unique([parentId, position], map: "Member_binary_slot")
}

model PaymentSubmission {
  id            String   @id @default(cuid())
  memberId      String
  member        Member   @relation(fields: [memberId], references: [id])
  purpose       String
  orderId       String?
  amount        Int
  referenceNo   String
  screenshotUrl String?
  status        String   @default("PENDING")
  adminNote     String?
  reviewedBy    String?
  reviewedAt    DateTime?
  createdAt     DateTime @default(now())
}

model KycSubmission {
  id          String    @id @default(cuid())
  memberId    String
  member      Member    @relation(fields: [memberId], references: [id])
  panNumber   String
  panImageUrl String
  status      String    @default("PENDING")
  adminNote   String?
  reviewedBy  String?
  reviewedAt  DateTime?
  createdAt   DateTime  @default(now())
}

model Pin {
  id                   String        @id @default(cuid())
  code                 String        @unique
  ownerId              String
  owner                Member        @relation("PinOwner", fields: [ownerId], references: [id])
  status               String        @default("UNUSED")
  paymentSubmissionId  String?
  generatedBy          String?
  usedAt               DateTime?
  usedForMemberId      String?
  assignedMemberCode   String?
  transfers            PinTransfer[]
  createdAt            DateTime      @default(now())
}

model PinTransfer {
  id            String   @id @default(cuid())
  pinId         String
  pin           Pin      @relation(fields: [pinId], references: [id])
  fromMemberId  String
  toMemberId    String
  transferredAt DateTime @default(now())
}

model Wallet {
  id       String        @id @default(cuid())
  memberId String        @unique
  member   Member        @relation(fields: [memberId], references: [id])
  balance  Int           @default(0)
  ledger   LedgerEntry[]
}

model LedgerEntry {
  id          String   @id @default(cuid())
  walletId    String
  wallet      Wallet   @relation(fields: [walletId], references: [id])
  type        String
  amount      Int
  grossAmount Int?
  gstCut      Int?
  adminCut    Int?
  note        String?
  createdAt   DateTime @default(now())
}

model BinaryVolume {
  id           String   @id @default(cuid())
  memberId     String
  member       Member   @relation(fields: [memberId], references: [id])
  date         String
  leftCount    Int      @default(0)
  rightCount   Int      @default(0)
  carryLeft    Int      @default(0)
  carryRight   Int      @default(0)
  pairsMatched Int      @default(0)
  payout       Int      @default(0)
  matched      Boolean  @default(false)

  @@unique([memberId, date])
}

model MatchingRun {
  id               String   @id @default(cuid())
  date             String   @unique
  ranAt            DateTime @default(now())
  membersProcessed Int
  pairsTotal       Int
  payoutTotal      Int
}

model Product {
  id          String  @id @default(cuid())
  name        String
  description String?
  dp          Int
  mrp         Int
  stock       Int     @default(0)
  active      Boolean @default(true)
  sortOrder   Int     @default(0)
  imageUrl    String?
  orders      Order[]
}

model Order {
  id        String   @id @default(cuid())
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
}

model PlanConfig {
  id                  String @id
  joiningAmount       Int
  pairValue           Int
  dailyPairCap        Int
  gstPercent          Int
  adminCutPercent     Int
  retailIncomePerUnit Int
}

model CompanySettings {
  id             String @id
  companyName    String
  accountName    String @default("")
  bankName       String @default("")
  accountNumber  String @default("")
  ifsc           String @default("")
  upiId          String @default("")
  rootMemberCode String @default("")
  contactEmail   String @default("")
  contactPhone   String @default("")
}

model WeeklyPayout {
  id              String    @id @default(cuid())
  memberId        String
  member          Member    @relation(fields: [memberId], references: [id])
  weekStart       String
  weekEnd         String
  generatedAmount Int
  matchingAmount  Int       @default(0)
  retailAmount    Int       @default(0)
  downlineTotal   Int       @default(0)
  downlineActive  Int       @default(0)
  downlinePending Int       @default(0)
  teamReport      String    @default("[]")
  status          String    @default("PENDING")
  adminNote       String?
  reviewedBy      String?
  reviewedAt      DateTime?
  createdAt       DateTime  @default(now())

  @@unique([memberId, weekStart])
}
