# Railway Postgres public URL (Render website uses this; private *.railway.internal will not work from Render)
DATABASE_URL="postgresql://postgres:PASSWORD@HOST.proxy.rlwy.net:PORT/railway?sslmode=require"

# Required in production. At least 24 random characters. Never commit the real value.
# PowerShell: [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Max 256 }) -as [byte[]])
JWT_SECRET="replace-with-a-long-random-string"

# production on Railway; leave unset for local `npm run dev`
# NODE_ENV=production

API_PORT=43124
API_HOST=0.0.0.0
NEXT_PUBLIC_API_BASE="/api"

# Public site URL when the browser talks to the API directly (comma-separated if several).
# Same-origin /api proxy does not need this.
# CORS_ORIGIN="https://your-app.up.railway.app"
